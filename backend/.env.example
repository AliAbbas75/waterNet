# Copy to backend/.env

# Mongo connection — single-node replica set so Mongoose transactions work.
MONGODB_URI=mongodb://localhost:27017/waternet?replicaSet=rs0&directConnection=true

# JWT secret for backend-issued auth tokens.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# HTTP server.
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Auth.
NODE_ENV=development
ALLOW_DEV_LOGIN=true
AUTH_BLOCKCHAIN_ENABLED=true

# Email delivery — OTP login codes and alert notifications.
# Priority 1: SMTP. Priority 2: Resend. If neither is set, output goes to console only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Print login codes to the server log.
#
# For running without a verified sending domain: Resend's shared testing sender
# only delivers to the account owner, so every other address gets no email. With
# this on, the code is in the log and a phone can still sign in.
#
# Anyone who can read the log can then sign in as anyone who requests a code.
# Turn it off once a real sender is configured. A code that could not be
# delivered is logged either way — an account nobody can get into is worse.
OTP_LOG_TO_CONSOLE=false

# Resend (used if SMTP_USER/SMTP_PASS/SMTP_FROM are not set)
RESEND_API_KEY=
RESEND_FROM=

# Blockchain auth (required when AUTH_BLOCKCHAIN_ENABLED=true)
#
# Only two of these are secrets you must supply. The registry address is
# derived, not chosen: the admin account deploys as its first transaction, so
# the contract always lands at the same address for a given admin key. Run
# `node scripts/ensure-chain.js --print-address` to compute it.
#
# CHAIN_RPC_URL is the one value that depends on WHERE the process runs rather
# than which deployment it belongs to. 127.0.0.1 is right when the backend runs
# on your host; in Docker it must be host.docker.internal or the service name,
# which is why docker-compose.yml overrides it.
AUTH_MASTER_KEY=
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_USER_REGISTRY_ADDRESS=
CHAIN_ADMIN_PRIVATE_KEY=
# QBFT validator identity. Its address is fixed inside genesis.json extraData;
# infra/besu-network/config/bootstrap.sh writes it to data/key at boot so the
# chain can be rebuilt on a new machine without the key living in git.
CHAIN_VALIDATOR_KEY=
# Optional: assign SUPER_ADMIN to a specific address on deploy.
# CHAIN_SUPER_ADMIN=

# Thirdweb (optional in dev; required only if exercising the production login flow).
# THIRDWEB_CLIENT_ID=
# THIRDWEB_API_BASE=https://api.thirdweb.com

# MQTT — set DISABLE_MQTT=false and fill credentials to enable live device ingestion.
# For EMQX Serverless: find your connection URL in cloud.emqx.com → Cluster → Overview.
# Always use mqtts:// (port 8883) for EMQX Serverless — plain mqtt:// is blocked.
# Create MQTT credentials in cloud.emqx.com → Access Control → Authentication.
# No custom CA cert needed; EMQX Serverless uses a trusted certificate chain.
DISABLE_MQTT=false
MQTT_BROKER_URL=mqtts://<cluster-id>.ala.<region>.emqxsl.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=waternet/v1/devices
# Optional tuning — defaults are sensible for a single backend instance.
# MQTT_CLIENT_ID=waternet-backend
# MQTT_RECONNECT_PERIOD_MS=2000
# MQTT_CONNECT_TIMEOUT_MS=10000
# MQTT_TLS_REJECT_UNAUTHORIZED=true
# MQTT_CA_CERT_PATH=   # only needed for self-signed broker certs

# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to browsers; the private key must stay secret.
# Leave unset to run without push — email still works and the settings screen
# says push is unavailable rather than failing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@waternet.local
