// ESP32 + Water Quality Sensors + EMQX MQTT (SSL)

// Libraries
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>

// ---------------- WIFI ----------------
const char* ssid = "StormFiber-9CB6-2.4G";
const char* password = "vTEk84Fd";

// ---------------- EMQX ----------------
const char* mqtt_server = "kf5b1ee1.ala.asia-southeast1.emqxsl.com"; // no https://
const int mqtt_port = 8883;

const char* mqtt_user = "waterNet";
const char* mqtt_pass = "fypiot";

const char* topic = "water/metrics";

// ---------------- SENSOR PINS ----------------
#define PH_PIN            34
#define TURBIDITY_PIN     35
#define TDS_PIN           32
#define FLOW_SENSOR_PIN   27

#define VREF 3.3
#define ADC_RESOLUTION 4095.0

// ---------------- FLOW SENSOR ----------------
volatile int flowPulseCount = 0;
float flowRate = 0;
float totalLitres = 0;
const float calibrationFactor = 7.5;

// ---------------- MQTT CLIENT ----------------
WiFiClientSecure espClient;
PubSubClient client(espClient);

// Interrupt
void IRAM_ATTR pulseCounter() {
  flowPulseCount++;
}

// ---------------- WIFI SETUP ----------------
void setup_wifi() {
  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected");
  Serial.println(WiFi.localIP());
}

// ---------------- MQTT RECONNECT ----------------
void reconnect() {

  while (!client.connected()) {

    Serial.println("Connecting to EMQX...");

    String clientId = "ESP32-" + String(random(0xffff), HEX);

    if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
      Serial.println("MQTT Connected!");
    } else {
      Serial.print("Failed, rc=");
      Serial.println(client.state());
      delay(5000);
    }
  }
}

// ---------------- SETUP ----------------
void setup() {
  Serial.begin(115200);

  analogReadResolution(12);

  pinMode(FLOW_SENSOR_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(FLOW_SENSOR_PIN), pulseCounter, FALLING);

  // IMPORTANT FIX FOR EMQX SERVERLESS
  espClient.setInsecure();

  client.setServer(mqtt_server, mqtt_port);

  setup_wifi();

  Serial.println("System Started");
}

// ---------------- LOOP ----------------
void loop() {

  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // ---------------- pH ----------------
  int phRaw = analogRead(PH_PIN);
  float phVoltage = phRaw * (VREF / ADC_RESOLUTION);
  float pHValue = 7 + ((2.5 - phVoltage) / 0.18);

  // ---------------- Turbidity ----------------
  int turbidityRaw = analogRead(TURBIDITY_PIN);
  float turbidityVoltage = turbidityRaw * (VREF / ADC_RESOLUTION);
  float turbidityPercent = map(turbidityRaw, 0, 4095, 100, 0);

  // ---------------- TDS ----------------
  int tdsRaw = analogRead(TDS_PIN);
  float tdsVoltage = tdsRaw * (VREF / ADC_RESOLUTION);

  float tdsValue =
    (133.42 * tdsVoltage * tdsVoltage * tdsVoltage
    - 255.86 * tdsVoltage * tdsVoltage
    + 857.39 * tdsVoltage) * 0.5;

  // ---------------- FLOW ----------------
  flowPulseCount = 0;
  delay(1000);

  flowRate = flowPulseCount / calibrationFactor;
  float litresThisSecond = flowRate / 60.0;
  totalLitres += litresThisSecond;

  // ---------------- JSON PAYLOAD ----------------
  String payload = "{";
  payload += "\"pH\":" + String(pHValue, 2);
  payload += ",\"turbidity\":" + String(turbidityPercent);
  payload += ",\"tds\":" + String(tdsValue, 0);
  payload += ",\"flowRate\":" + String(flowRate, 2);
  payload += ",\"totalLitres\":" + String(totalLitres, 3);
  payload += "}";

  // ---------------- PUBLISH ----------------
  client.publish(topic, payload.c_str());

  // ---------------- SERIAL MONITOR ----------------
  Serial.println("Sent to EMQX:");
  Serial.println(payload);
  Serial.println("----------------------");

  delay(3000);
}
