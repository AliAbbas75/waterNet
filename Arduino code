
// ============================================================
// ESP32 + Water Quality Sensors + EMQX MQTT (SSL)
// WaterNet MQTT Contract Implementation
// ============================================================

#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>

// ============================================================
// WIFI
// ============================================================

const char* ssid = "StormFiber-9CB6-2.4G";
const char* password = "vTEk84Fd";

// ============================================================
// EMQX
// ============================================================

const char* mqtt_server = "kf5b1ee1.ala.asia-southeast1.emqxsl.com";
const int mqtt_port = 8883;

const char* mqtt_user = "waterNet";
const char* mqtt_pass = "fypiot";

// Must already exist in MongoDB with disabled: false
const char* deviceId = "ESP32-de5e";

// ============================================================
// MQTT TOPICS
// ============================================================

// Device -> Backend
const char* telemetryTopic =
    "waternet/v1/devices/ESP32-de5e/telemetry";

const char* healthTopic =
    "waternet/v1/devices/ESP32-de5e/health";

// Broker -> Backend on ungraceful disconnect
const char* lwtTopic =
    "waternet/v1/devices/ESP32-de5e/lwt";

// Backend -> Subscribers
const char* latestTopic =
    "waternet/v1/devices/ESP32-de5e/latest";

const char* statusTopic =
    "waternet/v1/devices/ESP32-de5e/status";

// ============================================================
// SENSOR PINS
// ============================================================

#define PH_PIN            34
#define TURBIDITY_PIN     35
#define TDS_PIN           32
#define FLOW_SENSOR_PIN   27

#define VREF 3.3
#define ADC_RESOLUTION 4095.0

// ============================================================
// FLOW SENSOR
// ============================================================

volatile unsigned long flowPulseCount = 0;

float flowRate = 0.0;
float totalLitres = 0.0;

const float calibrationFactor = 7.5;

// ============================================================
// MQTT CLIENT
// ============================================================

WiFiClientSecure espClient;
PubSubClient client(espClient);

// ============================================================
// TIMERS
// ============================================================

// Telemetry every 10 seconds
unsigned long lastTelemetry = 0;
const unsigned long telemetryInterval = 10000;

// Health every 60 seconds
unsigned long lastHealth = 0;
const unsigned long healthInterval = 60000;

// Flow calculation every 1 second
unsigned long lastFlowCalculation = 0;
const unsigned long flowInterval = 1000;

// ============================================================
// INTERRUPT
// ============================================================

void IRAM_ATTR pulseCounter() {
  flowPulseCount++;
}

// ============================================================
// WIFI SETUP
// ============================================================

void setup_wifi() {

  Serial.println();
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi Connected!");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
}

// ============================================================
// MQTT CALLBACK
// Receives messages from:
// latest
// status
// ============================================================

void mqttCallback(char* topic, byte* payload, unsigned int length) {

  Serial.println();
  Serial.println("========== MQTT MESSAGE ==========");

  Serial.print("Topic: ");
  Serial.println(topic);

  Serial.print("Payload: ");

  for (unsigned int i = 0; i < length; i++) {
    Serial.print((char)payload[i]);
  }

  Serial.println();
  Serial.println("==================================");
}

// ============================================================
// MQTT RECONNECT
// ============================================================

void reconnect() {

  while (!client.connected()) {

    Serial.println();
    Serial.println("Connecting to EMQX...");

    // Stable and unique client ID
    String clientId = String(deviceId);

    // --------------------------------------------------------
    // LWT
    //
    // Broker publishes the raw string:
    //
    // offline
    //
    // NOT JSON.
    // --------------------------------------------------------

    const char* willPayload = "offline";

    bool connected = client.connect(
      clientId.c_str(),
      mqtt_user,
      mqtt_pass,
      lwtTopic,
      0,              // QoS
      false,          // Retain
      willPayload
    );

    if (connected) {

      Serial.println("MQTT Connected!");

      // Backend -> device/subscriber topics
      if (client.subscribe(latestTopic)) {
        Serial.println("Subscribed to latest");
      } else {
        Serial.println("Failed to subscribe to latest");
      }

      if (client.subscribe(statusTopic)) {
        Serial.println("Subscribed to status");
      } else {
        Serial.println("Failed to subscribe to status");
      }

      // Send health soon after connection
      lastHealth = 0;
      lastTelemetry = 0;

    } else {

      Serial.print("MQTT connection failed, rc=");
      Serial.println(client.state());

      delay(5000);
    }
  }
}

// ============================================================
// READ PH
// ============================================================

float readPH() {

  int phRaw = analogRead(PH_PIN);

  float phVoltage =
      phRaw * (VREF / ADC_RESOLUTION);

  float pHValue =
      7.0 + ((2.5 - phVoltage) / 0.18);

  return pHValue;
}

// ============================================================
// READ TURBIDITY
// ============================================================

float readTurbidity() {

  int turbidityRaw =
      analogRead(TURBIDITY_PIN);

  float turbidityPercent =
      map(
        turbidityRaw,
        0,
        4095,
        100,
        0
      );

  return turbidityPercent;
}

// ============================================================
// READ TDS
// ============================================================

float readTDS() {

  int tdsRaw =
      analogRead(TDS_PIN);

  float tdsVoltage =
      tdsRaw * (VREF / ADC_RESOLUTION);

  float tdsValue =
      (
        133.42 * tdsVoltage * tdsVoltage * tdsVoltage
        - 255.86 * tdsVoltage * tdsVoltage
        + 857.39 * tdsVoltage
      ) * 0.5;

  return tdsValue;
}

// ============================================================
// UPDATE FLOW
// ============================================================

void updateFlow() {

  noInterrupts();

  unsigned long pulses =
      flowPulseCount;

  flowPulseCount = 0;

  interrupts();

  flowRate =
      pulses / calibrationFactor;

  // flowRate is L/min
  float litresThisSecond =
      flowRate / 60.0;

  totalLitres +=
      litresThisSecond;
}

// ============================================================
// PUBLISH TELEMETRY
// ============================================================

void publishTelemetry() {

  float pHValue =
      readPH();

  float turbidity =
      readTurbidity();

  float tdsValue =
      readTDS();

  // ----------------------------------------------------------
  // TELEMETRY PAYLOAD
  //
  // Temperature has been completely removed.
  //
  // {
  //   "pH": 7.21,
  //   "turbidity": 1.4,
  //   "TDS": 310,
  //   "flowRate": 12.5,
  //   "totalLitres": 84.212
  // }
  // ----------------------------------------------------------

  String payload = "{";

  payload += "\"pH\":";
  payload += String(pHValue, 2);

  payload += ",\"turbidity\":";
  payload += String(turbidity, 2);

  payload += ",\"TDS\":";
  payload += String(tdsValue, 0);

  payload += ",\"flowRate\":";
  payload += String(flowRate, 2);

  payload += ",\"totalLitres\":";
  payload += String(totalLitres, 3);

  payload += "}";

  bool success =
      client.publish(
        telemetryTopic,
        payload.c_str(),
        false
      );

  Serial.println();
  Serial.println("========== TELEMETRY ==========");

  if (success) {
    Serial.println("Published successfully");
  } else {
    Serial.println("Telemetry publish FAILED");
  }

  Serial.print("Topic: ");
  Serial.println(telemetryTopic);

  Serial.print("Payload: ");
  Serial.println(payload);

  Serial.println("===============================");
}

// ============================================================
// PUBLISH HEALTH
// ============================================================

void publishHealth() {

  unsigned long uptimeSeconds =
      millis() / 1000;

  String connectivityStatus;

  if (WiFi.status() == WL_CONNECTED &&
      client.connected()) {

    connectivityStatus = "good";

  } else if (WiFi.status() != WL_CONNECTED) {

    connectivityStatus = "wifi_disconnected";

  } else {

    connectivityStatus = "mqtt_disconnected";
  }

  // ----------------------------------------------------------
  // HEALTH PAYLOAD
  //
  // {
  //   "uptime": 3600,
  //   "connectivityStatus": "good"
  // }
  // ----------------------------------------------------------

  String payload = "{";

  payload += "\"uptime\":";
  payload += String(uptimeSeconds);

  payload += ",\"connectivityStatus\":\"";
  payload += connectivityStatus;
  payload += "\"";

  payload += "}";

  bool success =
      client.publish(
        healthTopic,
        payload.c_str(),
        false
      );

  Serial.println();
  Serial.println("============ HEALTH ============");

  if (success) {
    Serial.println("Published successfully");
  } else {
    Serial.println("Health publish FAILED");
  }

  Serial.print("Topic: ");
  Serial.println(healthTopic);

  Serial.print("Payload: ");
  Serial.println(payload);

  Serial.println("================================");
}

// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("======================================");
  Serial.println(" WaterNet ESP32 Device");
  Serial.println("======================================");

  analogReadResolution(12);

  // Flow sensor
  pinMode(
    FLOW_SENSOR_PIN,
    INPUT_PULLUP
  );

  attachInterrupt(
    digitalPinToInterrupt(FLOW_SENSOR_PIN),
    pulseCounter,
    FALLING
  );

  // SSL
  // For development/testing.
  // Use the EMQX CA certificate in production.
  espClient.setInsecure();

  // MQTT
  client.setServer(
    mqtt_server,
    mqtt_port
  );

  client.setCallback(mqttCallback);

  // WiFi
  setup_wifi();

  Serial.println();
  Serial.println("System Started");
  Serial.print("Device ID: ");
  Serial.println(deviceId);
  Serial.println();
}

// ============================================================
// LOOP
// ============================================================

void loop() {

  // MQTT connection
  if (!client.connected()) {
    reconnect();
  }

  client.loop();

  unsigned long currentMillis =
      millis();

  // ----------------------------------------------------------
  // FLOW CALCULATION
  // ----------------------------------------------------------

  if (
    currentMillis - lastFlowCalculation
    >= flowInterval
  ) {

    lastFlowCalculation =
        currentMillis;

    updateFlow();
  }

  // ----------------------------------------------------------
  // TELEMETRY
  // ----------------------------------------------------------

  if (
    currentMillis - lastTelemetry
    >= telemetryInterval
  ) {

    lastTelemetry =
        currentMillis;

    if (client.connected()) {
      publishTelemetry();
    }
  }

  // ----------------------------------------------------------
  // HEALTH
  // ----------------------------------------------------------

  if (
    currentMillis - lastHealth
    >= healthInterval
  ) {

    lastHealth =
        currentMillis;

    if (client.connected()) {
      publishHealth();
    }
  }
}

